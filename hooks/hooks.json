{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-hook\" hook session-start"}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-hook\" hook prompt"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-hook\" hook write"}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-hook\" hook bash"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-hook\" hook post"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-hook\" hook stop"}
        ]
      }
    ]
  }
}
