#!/bin/sh
"exec" "sh" "-c" 'd=${0%/*}; [ "$d" = "$0" ] && d=.; exec sh "$d/run-hook" "$@"' "$0" "$@"  # sh: pick a real Python (not the Windows Store stub); Python: a no-op string
"""Run no-git-slop from a checkout or plugin install, no pip install needed."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

if len(sys.argv) == 3 and sys.argv[1] == "hook":
    # Hooks run on every tool call: skip importing the CLI (argparse and friends, ~100 ms on Windows).
    from no_git_slop import hooks  # noqa: E402

    if sys.argv[2] in hooks.HANDLERS:
        sys.exit(hooks.run(sys.argv[2]))

from no_git_slop.cli import main  # noqa: E402

sys.exit(main())
